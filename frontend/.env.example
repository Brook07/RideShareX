# Environment Variables Template for Frontend Deployment

# Backend API URL (Update after deploying backend)
REACT_APP_API_URL=https://your-backend-app.railway.app

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Configuration
REACT_APP_CLOUDINARY_CLOUD_NAME=dtgrovkrh
REACT_APP_CLOUDINARY_UPLOAD_PRESET=react_uploads
